
#  Field Name		Mapping Function			Description
@field (rd,rs1,rs2,rs3) """
   rd[11:7]		'suffix("f|d") ? n+32 : n'		# Float registers come after integer registers
   rs1[19:15]		'suffix("f|d") ? n+32 : n'
   rs2[24:20]		'suffix("f|d") ? n+32 : n'
   rs3[31:27]		'suffix("f|d") ? n+32 : n'
   cs2[6:2]		'suffix("f|d") ? n+32 : n'		# rs2 moves here in compressed instructions
   c1[9:7]		'8 + (suffix("f|d") ? n+32 : n)'	# Always add 8, then add 32 if .f or .d
   c2[4:2]		'8 + (suffix("f|d") ? n+32 : n)'
"""





#  Opcode	Instruction Bits						Flags		Assembler	Action

# RVC Compressed Instruction Set, Quadrant 0
   c.addi4spn	"000 {5:4|9:6|2|3}         c2.l 00"(c2,c1)			C		Ct,Cc,CK	"wrd(c1+imm)"
   c.fld	"001 {5:3}    c1.l {7:6}   c2.d 00"(c2,c1)			C,F,ld		CD,Cl(Cs)	"wdd(f64(LOAD(uint64_t, c1+imm)))"
   c.lw		"010 {5:3}    c1.l {2|6}   c2.w 00"(c2,c1)			C,ld		Ct,Cl(Cs)	"wrd(LOAD( int32_t, c1+imm))"
   c.ld		"011 {5:3}    c1.l {7:6}   c2.l 00"(c2,c1)			64,C,ld		Ct,Cl(Cs)	"wrd(LOAD( int64_t, c1+imm))"
   c.flw	"011 {5:3}    c1.l {2|6}   c2.f 00"(-, c1,c2)			32,C,F,ld	Ct,Cl(Cs)	"wfd(f32(LOAD(uint32_t, c1+imm)))"
   c.fsd	"101 {5:3}    c1.l {7:6}   c2.d 00"(-, c1,c2)			C,D,st		CD,Cl(Cs)	"STORE(uint64_t, c1+imm, c2.v)"
   c.sw		"110 {5:3}    c1.l {2|6}   c2.w 00"(-, c1,c2)			C,st		Ct,Cl(Cs)	"STORE( int32_t, c1+imm, c2)"
   c.sd		"111 {5:3}    c1.l {7:6}   c2.l 00"(-, c1,c2)			C,st		Ct,Cl(Cs)	"STORE( int64_t, c1+imm, c2)"

# RVC Compressed Instruction Set, Quadrant 1
   c.addi	"000 {-5}   rd.l   {4:0}        01"(rd,rd)			C		d,Cj		"wrd(rd + imm)"
   c.addiw	"001 {-5}   rd.w   {4:0}        01"(rd,rd)			64,C		d,Cj		"wrd(int32_t(rd) + int32_t(imm))"
   c.jal	"001 {-11|4|9:8|10|6|7|3:1|5}   01"()				32,C,uj,>	-		"{ wrd(s.pc+2); jump(s.pc+imm) }"
   c.li		"010 {-5}   rd.l   {4:0}        01"(rd)				C		-		"wrd(imm)"
   c.addi16sp	"011 {-9}  00010   {4|6|8:7|5}  01"(rd,rd)			C		-		"wrd(rd+imm)"
   c.lui	"011 {-17}  rd.l   {16:12}      01"(rd)				C		-		"wrd(imm)"
   c.srli	"100 {5}   00 c1.l {4:0}        01"(c1,c1)			C		-		"wrd(c1 >> imm)"
   c.srai	"100 {5}   01 c1.l {4:0}        01"(c1,c1)			C		-		"wrd(c1 >> imm)"
   c.andi	"100 {-5}  10 c1.l {4:0}        01"(c1,c1)			C		-		"wrd(c1 & imm)"
   c.sub	"100 0     11 c1.l   00    c2.l 01"(c1,c1,c2)			C		-		"wrd(c1 - r2)"
   c.xor	"100 0     11 c1.l   01    c2.l 01"(c1,c1,c2)			C		-		"wrd(c1 ^ r2)"
   c.or		"100 0     11 c1.l   10    c2.l 01"(c1,c1,c2)			C		-		"wrd(c1 | r2)"
   c.and	"100 0     11 c1.l   11    c2.l 01"(c1,c1,c2)			C		-		"wrd(c1 & r2)"
   c.subw	"100 1     11 c1.w   00    c2.w 01"(c1,c1,c2)			C		-		"wrd(int32_t(c1) - int32_t(c2))"
   c.addw	"100 1     11 c1.w   01    c2.w 01"(c1,c1,c2)			C		-		"wrd(int32_t(c1) + int32_t(c2))"
   c.j		"101 {-11|4|9:8|10|6|7|3:1|5}   01"()				C,uj,>		-		"jump(s.pc+imm)"
   c.beqz	"110 {-8|4:3} c1.l {7:6|2:1|5}  01"(-,c1)			C,cj,>		-		"branch(c1==0, s.pc+imm, s.pc+2)"
   c.bnez	"111 {-8|4:3} c1.l {7:6|2:1|5}  01"(-,c1)			C,cj,>		-		"branch(c1!=0, s.pc+imm, s.pc+2)"

# RVC Compressed Instruction Set, Quadrant 2
   c.slli	"000 {5}    rd.l  {4:0}         10"(rd,rd)			C		-		"wrd(rd << imm)"
   c.fldsp	"001 {5}    rd.d  {4:3|8:6}     10"(rd)				C,D,ld		-		"wdd(f64(LOAD(uint64_t, sp+imm)))"
   c.lwsp	"010 {5}    rd.w  {4:2|7:6}     10"(rd)				64,C,ld		-		"wrd(LOAD( int32_t, sp+imm))"
   c.flwsp	"011 {5}    rd.f  {4:2|7:6}     10"(rd)				32,C,F,ld	-		"wfd(f32(LOAD(uint32_t, sp+imm)))"
   c.ldsp	"011 {5}    rd.l  {4:3|8:6}     10"(rd)				C,ld		-		"wrd(LOAD( int64_t, sp+imm))"
   c.ret	"100 0      00001         00000 10"()				C,uj,>		-		"reg_jump(rd)"
   c.jr		"100 0      rd.l          00000 10"(rd)				C,uj,>		-		"reg_jump(rd)"
   c.mv		"100 0      rd.l          cs2.l 10"(rd,cs2)			C		-		"wrd(cs2)"
   c.ebreak	"100 1      00000         00000 10"()				C,ex		-		"ebreak()"
   c.jalr	"100 1      rd.l          00000 10"(rd,rd)			C,uj,>		-		"{ long npc=rd; wrd(s.pc+2); jump(npc); }"
   c.add	"100 1      rd.l          cs2.l 10"(rd,rd,cs2)			C		-		"wrd(rd + cs2)"
   c.fsdsp	"101 {5:3|8:6}            cs2.l 10"(-,cs2)			C,D,st		-		"STORE(uint64_t, sp+imm, cs2.v)"
   c.swsp	"110 {5:2|7:6}            cs2.l 10"(-,cs2)			C,st		-		"STORE(int32_t,  sp+imm, cs2)"
   c.sdsp	"111 {5:3|8:6}            cs2.l 10"(-,cs2)			64,C,st		-		"STORE(int64_t,  sp+imm, cs2)"
   c.fswsp	"111 {5:2|7:6}            cs2.l 10"(-,cs2)			32,C,F,st	-		"STORE(uint32_t, sp+imm, cs2.v)"



# RV32I Base Instruction Set
   lui		"{-31:12}                       rd.l  01101 11"		I		d,u		"wrd(     imm)"
   auipc	"{-31:12}                       rd.l  00101 11"		I		d,u		"wrd(s.pc+imm)"

   j		"{-20|10:1|11|19:12}            00000 11011 11"		I,uj,>		a		"             jump(s.pc+imm)"
   jal		"{-20|10:1|11|19:12}            rd.l  11011 11"		I,uj,>		d,a		"wrd(s.pc+4); jump(s.pc+imm)"
   ret		"{-11:0}            00001 000   00000 11001 11"		I,uj,>		d,s		"reg_jump((r1+imm)&~1L)"
   jr		"{-11:0}            rs1.l 000   00000 11001 11"		I,uj,>		d,s		"reg_jump((r1+imm)&~1L)"
   jalr		"{-11:0}            rs1.l 000   rd.l  11001 11"		I,uj,>		d,s		"{ long npc=(r1+imm)&~1L; wrd(s.pc+4); reg_jump(npc); }"

   beq		"{-12|10:5}  rs2.l  rs1.l 000 {4:1|11} 1100011"		I,cj,>		s,t,p		"branch(r1 == r2, s.pc+imm, s.pc+4)"
   bne		"{-12|10:5}  rs2.l  rs1.l 001 {4:1|11} 1100011"		I,cj,>		s,t,p		"branch(r1 != r2, s.pc+imm, s.pc+4)"
   blt		"{-12|10:5}  rs2.l  rs1.l 100 {4:1|11} 1100011"		I,cj,>		s,t,p		"branch(r1 <  r2, s.pc+imm, s.pc+4)"
   bge		"{-12|10:5}  rs2.l  rs1.l 101 {4:1|11} 1100011"		I,cj,>		s,t,p		"branch(r1 >= r2, s.pc+imm, s.pc+4)"
   bltu		"{-12|10:5}  rs2.l  rs1.l 110 {4:1|11} 1100011"		I,cj,>		s,t,p		"branch(u1 <  u2, s.pc+imm, s.pc+4)"
   bgeu		"{-12|10:5}  rs2.l  rs1.l 111 {4:1|11} 1100011"		I,cj,>		s,t,p		"branch(u1 >= u2, s.pc+imm, s.pc+4)"

   lb		"{-11:0}            rs1.l 000   rd.l  00000 11"		I,ld		d,o(s)		"wrd(LOAD( int8_t,  r1+imm))"
   lh		"{-11:0}            rs1.l 001   rd.l  00000 11"		I,ld		d,o(s)		"wrd(LOAD( int16_t, r1+imm))"
   lw		"{-11:0}            rs1.l 010   rd.l  00000 11"		I,ld		d,o(s)		"wrd(LOAD( int32_t, r1+imm))"
   lbu		"{-11:0}            rs1.l 100   rd.l  00000 11"		I,ld		d,o(s)		"wud(LOAD(uint8_t,  r1+imm))"
   lhu		"{-11:0}            rs1.l 101   rd.l  00000 11"		I,ld		d,o(s)		"wud(LOAD(uint16_t, r1+imm))"
   sb		"{-11:5}     rs2.l  rs1.l 000   {4:0} 01000 11"		I,st		t,q(s)		"STORE(int8_t,  r1+imm, r2)"
   sh		"{-11:5}     rs2.l  rs1.l 001   {4:0} 01000 11"		I,st		t,q(s)		"STORE(int16_t, r1+imm, r2)"
   sw		"{-11:5}     rs2.l  rs1.l 010   {4:0} 01000 11"		I,st		t,q(s)		"STORE(int32_t, r1+imm, r2)"

   addi		"{-11:0}            rs1.l 000   rd.l  00100 11"		I		d,s,j		"wrd(r1 +  imm)"
   slti		"{-11:0}            rs1.l 010   rd.l  00100 11"		I		d,s,j		"wrd(r1 <  imm)"
   sltiu	"{-11:0}            rs1.l 011   rd.l  00100 11"		I		d,s,j		"wud(u1 < uimm)"
   xori		"{-11:0}            rs1.l 100   rd.l  00100 11"		I		d,s,j		"wud(r1 ^  imm)"
   ori		"{-11:0}            rs1.l 110   rd.l  00100 11"		I		d,s,j		"wud(r1 |  imm)"
   andi		"{-11:0}            rs1.l 111   rd.l  00100 11"		I		d,s,j		"wud(r1 &  imm)"
   slli		"000000      {5:0}  rs1.l 001   rd.l  00100 11"		I		d,s,>		"wrd(r1 << imm)"
   srli		"000000      {5:0}  rs1.l 101   rd.l  00100 11"		I		d,s,>		"wud(u1 >> imm)"
   srai		"010000      {5:0}  rs1.l 101   rd.l  00100 11"		I		d,s,>		"wrd(r1 >> imm)"

   add		"0000000     rs2.l  rs1.l 000   rd.l  01100 11"		I		d,s,t		"wrd(r1 + r2)"
   sub		"0100000     rs2.l  rs1.l 000   rd.l  01100 11"		I		d,s,t		"wrd(r1 - r2)"
   sll		"0000000     rs2.l  rs1.l 001   rd.l  01100 11"		I		d,s,t		"wrd(r1 << r2)"
   slt		"0000000     rs2.l  rs1.l 010   rd.l  01100 11"		I		d,s,t		"wrd(r1 <  r2)"
   sltu		"0000000     rs2.l  rs1.l 011   rd.l  01100 11"		I		d,s,t		"wrd(u1 <  u2)"
   xor		"0000000     rs2.l  rs1.l 100   rd.l  01100 11"		I		d,s,t		"wrd(u1 ^  u2)"
   srl		"0000000     rs2.l  rs1.l 101   rd.l  01100 11"		I		d,s,t		"wrd(u1 >> u2)"
   sra		"0100000     rs2.l  rs1.l 101   rd.l  01100 11"		I		d,s,t		"wrd(r1 >> r2)"
   or		"0000000     rs2.l  rs1.l 110   rd.l  01100 11"		I		d,s,t		"wrd(u1 |  u2)"
   and		"0000000     rs2.l  rs1.l 111   rd.l  01100 11"		I		d,s,t		"wrd(u1 &  u2)"

   fence	"{11:0}             rs1.l 000   rd.l  00011 11"		<,I,ex,>	d,s,j		"fence(imm)"
   fence.i	"{11:0}             rs1.l 001   rd.l  00011 11"		<,I,ex,>	d,s,j		"fence_i(imm)"
   ecall	"000000000000       00000 000   00000 11100 11"		<,I,ex,>	-		"wrd(riscv_syscall(this, r1))"
   ebreak	"000000000001       00000 000   00000 11100 11"		I,ex		-		"ebreak()"

   csrrw	"{11:0}             rs1.l 001   rd.l  11100 11"		<,I,sr,>	d,E,s		"wrd(csr_func(imm,       [&](uxlen_t old) { return        u1;        } ))"
   csrrs	"{11:0}             rs1.l 010   rd.l  11100 11"		<,I,sr,>	d,E,s		"wrd(csr_func(imm,       [&](uxlen_t old) { return old |  u1;        } ))"
   csrrc	"{11:0}             rs1.l 011   rd.l  11100 11"		<,I,sr,>	d,E,s		"wrd(csr_func(imm,       [&](uxlen_t old) { return old & ~u1;        } ))"
   csrrwi	"{11:0}           {16:12} 101   rd.l  11100 11"		<,I,sr,>	d,E,Z		"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return        (uimm>>12); } ))"
   csrrsi	"{11:0}           {16:12} 110   rd.l  11100 11"		<,I,sr,>	d,E,Z		"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return old |  (uimm>>12); } ))"
   csrrci	"{11:0}           {16:12} 111   rd.l  11100 11"		<,I,sr,>	d,E,Z		"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return old & ~(uimm>>12); } ))"


# RV64I Base Instruction Set (in addition to RV32I)
   lwu		"{-11:0}            rs1.l 110   rd.l  00000 11"		64,I,ld		d,o(s)		"wrd(LOAD(uint32_t, r1+imm))"
   ld		"{-11:0}            rs1.l 011   rd.l  00000 11"		64,I,ld		d,o(s)		"wrd(LOAD(int64_t,  r1+imm))"
   sd		"{-11:5}     rs2.l  rs1.l 011   {4:0} 01000 11"		64,I,st		t,q(s)		"STORE(int64_t, r1+imm, r2)"

   addiw	"{-11:0}            rs1.l 000   rd.l  00110 11"		64,I		d,s,j		"wrd( int32_t(r1) +  int32_t(imm))"
   slliw	"0000000     {4:0}  rs1.l 001   rd.l  00110 11"		64,I		d,s,<		"wrd( int32_t(r1) << int32_t(imm))"
   srliw	"0000000     {4:0}  rs1.l 101   rd.l  00110 11"		64,I		d,s,<		"wrd(uint32_t(r1) >> int32_t(imm))"
   sraiw	"0100000     {4:0}  rs1.l 101   rd.l  00110 11"		64,I		d,s,<		"wrd( int32_t(r1) >> int32_t(imm))"

   addw		"0000000     rs2.l  rs1.l 000   rd.l  01110 11"		64,I		d,s,t		"wrd( int32_t(r1) +   int32_t(r2))"
   subw		"0100000     rs2.l  rs1.l 000   rd.l  01110 11"		64,I		d,s,t		"wrd( int32_t(r1) -   int32_t(r2))"
   sllw		"0000000     rs2.l  rs1.l 001   rd.l  01110 11"		64,I		d,s,t		"wrd( int32_t(r1) <<  int32_t(r2))"
   srlw		"0000000     rs2.l  rs1.l 101   rd.l  01110 11"		64,I		d,s,t		"wrd(uint32_t(r1) >>  int32_t(r2))"
   sraw		"0100000     rs2.l  rs1.l 101   rd.l  01110 11"		64,I		d,s,t		"wrd( int32_t(r1) >>  int32_t(r2))"


# RV32M Standard Extension
   mul		"0000001     rs2.l  rs1.l 000   rd.l  01100 11"		M		d,s,t		"wrd(r1 * r2)"
   mulh		"0000001     rs2.l  rs1.l 001   rd.l  01100 11"		M		d,s,t		"wrd(mulh  (r1, r2))"
   mulhsu	"0000001     rs2.l  rs1.l 010   rd.l  01100 11"		M		d,s,t		"wrd(mulhsu(r1, r2))"
   mulhu	"0000001     rs2.l  rs1.l 011   rd.l  01100 11"		M		d,s,t		"wrd(mulhu (r1, r2))"
   div		"0000001     rs2.l  rs1.l 100   rd.l  01100 11"		M		d,s,t		"wrd(r2==0 ?  INT64_MAX : (r1==INT64_MIN && r2==-1) ? r1 : r1/r2)"
   divu		"0000001     rs2.l  rs1.l 101   rd.l  01100 11"		M		d,s,t		"wrd(r2==0 ? UINT64_MAX : (uint64_t)r1/(uint64_t)r2         "
   rem		"0000001     rs2.l  rs1.l 110   rd.l  01100 11"		M		d,s,t		"lrd,ls1,ls2,-	"wrd(r2==0 ?  INT64_MAX : (r1==INT64_MIN && r2==-1) ? r1 : r1%r2)"
   remu		"0000001     rs2.l  rs1.l 111   rd.l  01100 11"		M		d,s,t		"wrd(r2==0 ? UINT64_MAX : (uint64_t)r1%(uint64_t)r2             )"


# RV64M Standard Extension (in addition to RV32M)
   mulw		"0000001     rs2.l  rs1.l 000   rd.l  01110 11"		64,M		d,s,t		"wrd((int32_t)r1 * (int32_t)r2)"
   divw		"0000001     rs2.l  rs1.l 100   rd.l  01110 11"		64,M		d,s,t		"wrd(r2==0 ? UINT64_MAX : ( int32_t)r1/( int32_t)r2)"
   divuw	"0000001     rs2.l  rs1.l 101   rd.l  01110 11"		64,M		d,s,t		"wrd(r2==0 ? UINT64_MAX : (uint32_t)r1/(uint32_t)r2)"
   remw		"0000001     rs2.l  rs1.l 110   rd.l  01110 11"		64,M		d,s,t		"wrd(r2==0 ? UINT64_MAX : ( int32_t)r1%( int32_t)r2)"
   remuw	"0000001     rs2.l  rs1.l 111   rd.l  01110 11"		64,M		d,s,t		"wrd(r2==0 ? UINT64_MAX : (uint32_t)r1%(uint32_t)r2)"


# RV32A Standard Extension
   lr.w		"00010 {1:0} 00000  rs1.l 010   rd.l  01011 11"		A,amo,ld	d,0(s)		"wrd(load_reserved(int32_t, r1))"
   sc.w		"00011 {1:0} rs2.l  rs1.l 010   rd.l  01011 11"		A,amo,st,>	d,t,0(s)	"wrd(store_conditional(int32_t, r1, r2))"
   amoswap.w	"00001 {1:0} rs2.l  rs1.l 010   rd.l  01011 11"		A,amo,rmw,>	d,t,0(s)	"wrd(amo_int32(r1, [&](int32_t lhs) { return       r2; }, ap))"
   amoadd.w	"00000 {1:0} rs2.l  rs1.l 010   rd.l  01011 11"		A,amo,rmw,>	d,t,0(s)	"wrd(amo_int32(r1, [&](int32_t lhs) { return lhs + r2; }, ap))"
   amoxor.w	"00100 {1:0} rs2.l  rs1.l 010   rd.l  01011 11"		A,amo,rmw,>	d,t,0(s)	"wrd(amo_int32(r1, [&](int32_t lhs) { return lhs ^ r2; }, ap))"
   amoand.w	"01100 {1:0} rs2.l  rs1.l 010   rd.l  01011 11"		A,amo,rmw,>	d,t,0(s)	"wrd(amo_int32(r1, [&](int32_t lhs) { return lhs & r2; }, ap))"
   amoor.w	"01000 {1:0} rs2.l  rs1.l 010   rd.l  01011 11"		A,amo,rmw,>	d,t,0(s)	"wrd(amo_int32(r1, [&](int32_t lhs) { return lhs | r2; }, ap))"
   amomin.w	"10000 {1:0} rs2.l  rs1.l 010   rd.l  01011 11"		A,amo,rmw,>	d,t,0(s)	"wrd(amo_int32(r1, [&](int32_t lhs) { return std::min(lhs, (int32_t)r2); }, ap))"
   amomax.w	"10100 {1:0} rs2.l  rs1.l 010   rd.l  01011 11"		A,amo,rmw,>	d,t,0(s)	"wrd(amo_int32(r1, [&](int32_t lhs) { return std::max(lhs, (int32_t)r2); }, ap))"
