# Internal instructions to emulate Compare-And-Swap
   cas.w	"rs3.l 10    rs2.l  rs1.l 111   rd.l  11111 11"		A,amo,rmw,>	d,t,0(s),r	"wrd(cas32(r1, r2, r3, ap))"
   cas.d	"rs3.l 11    rs2.l  rs1.l 111   rd.l  11111 11"		64,A,amo,rmw,>	d,t,0(s),r	"wrd(cas64(r1, r2, r3, ap))"


# RV32F Standard Extension
   flw		"{-11:0}            rs1.l 010   rd.f  00001 11"		D,o(s)		F,ld		"wfd(f32(LOAD(uint32_t, r1+imm)))"
   fsw		"{-11:5}     rs2.l  rs1.f 010   {4:0} 01001 11"		T,q(s)		F,st		"STORE(uint32_t, r1+imm, r2.v)"

   fmadd.s	"rs3.f 00    rs2.f  rs1.f {2:0} rd.f  10000 11"		D,S,T,R,m	F,fp		"srm; wfd(f32_mulAdd(f1,                 f2,     f3            )); sfx"
   fmsub.s	"rs3.f 00    rs2.f  rs1.f {2:0} rd.f  10001 11"		D,S,T,R,m	F,fp		"srm; wfd(f32_mulAdd(f1,                 f2, f32(f3.v^F32_SIGN))); sfx"
   fnmsub.s	"rs3.f 00    rs2.f  rs1.f {2:0} rd.f  10010 11"		D,S,T,R,m	F,fp		"srm; wfd(f32_mulAdd(f32(f1.v^F32_SIGN), f2,     f3            )); sfx"
   fnmadd.s	"rs3.f 00    rs2.f  rs1.f {2:0} rd.f  10011 11"		D,S,T,R,m	F,fp		"srm; wfd(f32_mulAdd(f32(f1.v^F32_SIGN), f2, f32(f3.v^F32_SIGN))); sfx"
   
   fmin.s	"00101 00    rs2.f  rs1.f 000   rd.f  10100 11"		D,S,T		F,fp		"     wfd(fmin_s(f1, f2))"
   fmax.s	"00101 00    rs2.f  rs1.f 001   rd.f  10100 11"		D,S,T		F,fp		"     wfd(fmax_s(f1, f2))"
   fadd.s	"00000 00    rs2.f  rs1.f {2:0} rd.f  10100 11"		D,S,T,m		F,fP		"srm; wfd(f32_add(f1, f2)); sfx"
   fsub.s	"00001 00    rs2.f  rs1.f {2:0} rd.f  10100 11"		D,S,T,m		F,fp		"srm; wfd(f32_sub(f1, f2)); sfx"
   fmul.s	"00010 00    rs2.f  rs1.f {2:0} rd.f  10100 11"		D,S,T,m		F,fp		"srm; wfd(f32_mul(f1, f2)); sfx"
   fdiv.s	"00011 00    rs2.f  rs1.f {2:0} rd.f  10100 11"		D,S,T,m		F,fp		"srm; wfd(f32_div(f1, f2)); sfx"
   fsqrt.s	"01011 00    00000  rs1.f {2:0} rd.f  10100 11"		D,S,m		F,fp		"srm; wfd(f32_sqrt(f1));    sfx"
															                                                       
   feq.s	"10100 00    rs2.f  rs1.f 010   rd.l  10100 11"		d,S,T		F,fp		"     wrd(f32_eq(f1, f2))"
   flt.s	"10100 00    rs2.f  rs1.f 001   rd.l  10100 11"		d,S,T		F,fp		"     wrd(f32_lt(f1, f2))"                 
   fle.s	"10100 00    rs2.f  rs1.f 000   rd.l  10100 11"		d,S,T		F,fp		"     wrd(f32_lt(f1, f2))"
   fclass.s	"11100 00    00000  rs1.f 001   rd.l  10100 11"		d,S		F,fp		"     wrd(f32_classify(f1))"
   
   fmv.s	"00100 00    rs2.f  rs1.f 000   rd.f  10100 11"		D,S,T		F,fp		"     wfd(fsgnj_s(f1, f2, false, false))"
   fsgnjn.s	"00100 00    rs2.f  rs1.f 001   rd.f  10100 11"		D,S,T		F,fp		"     wfd(fsgnj_s(f1, f2, true,  false))"
   fsgnjx.s	"00100 00    rs2.f  rs1.f 010   rd.f  10100 11"		D,S,T		F,fp		"     wfd(fsgnj_s(f1, f2, false,  true))"

   fcvt.w.s	"11000 00    00000  rs1.w {2:0} rd.f  10100 11"		d,S,m		F,fp		"srm; wrd(f32_to_i32( f1, RM, true)); sfx"
   fcvt.wu.s	"11000 00    00001 rs1.uw {2:0} rd.f  10100 11"		d,S,m		F,fp		"srm; wrd(f32_to_ui32(f1, RM, true)); sfx"
