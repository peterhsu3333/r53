   fmv.x.w	"11100 00    00000  rs1.f 000   rd.l  10100 11"		d,S		F,fp		"     wrd(f1.v)"
   fmv.w.x	"11110 00    00000  rs1.w 000   rd.f  10100 11"		d,S		F,fp		"     wfd(f32(r1))"                                    

