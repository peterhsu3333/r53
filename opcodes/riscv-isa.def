
#  Field Name		Mapping Function			Description
@field (rd,rs1,rs2,rs3) """
    rd[11:7]		'n'					# Integer registers numbered 0-31
   rs1[19:15]		'n'
   rs2[24:20]		'n'
   rs3[31:27]		'n'
   cs2[6:2]		'n'					# rs2 moves here in compressed instructions
    c1[9:7]		'n+8'					# Compressed registers
    c2[4:2]		'n+8'

    fd[11:7]		'n+32'					# Float registers numbered 32-63
   fs1[19:15]		'n+32'
   fs2[24:20]		'n+32'
   fs3[31:27]		'n+32'
   fcs2[6:2]		'n+32'
   fc1[9:7]		'n+8+32'
   fc2[4:2]		'n+8+32'
"""





#  Opcode	Instruction Bits				Registers		Flags		Assembler	Action

# RVC Compressed Instruction Set, Quadrant 0
   c.addi4spn	"000 {5:4|9:6|2|3}         c2 00"		c2.l			C		Ct,Cc,CK	"wrd(sp+imm)"
   c.fld	"001 {5:3}    c1 {7:6}     c2 00"		c2.d,c1.l		C,F,ld		CD,Cl(Cs)	"wfd(f64(LOAD(double_t, r1+imm)))"
   c.lw		"010 {5:3}    c1 {2|6}     c2 00"		c2.w,c1.l		C,ld		Ct,Cl(Cs)	"wrd(LOAD( int32_t, r1+imm))"
   c.ld		"011 {5:3}    c1 {7:6}     c2 00"		c2.f,c1.l		64,C,ld		Ct,Cl(Cs)	"wrd(LOAD( int64_t, r1+imm))"
   c.flw	"011 {5:3}    c1 {2|6}     c2 00"		c2.d,c1.l		32,C,F,ld	Ct,Cl(Cs)	"wfd(f32(LOAD(uint32_t, r1+imm)))"
   c.fsd	"101 {5:3}    c1 {7:6}     c2 00"		-,c1.l,c2.d		C,D,st		CD,Cl(Cs)	"STORE(uint64_t, r1+imm, r2.v)"
   c.sw		"110 {5:3}    c1 {2|6}     c2 00"		-,c1.l,c2.w		C,st		Ct,Cl(Cs)	"STORE( int32_t, r1+imm, r2)"
   c.sd		"111 {5:3}    c1 {7:6}     c2 00"		-,c1.l,c2.l		C,st		Ct,Cl(Cs)	"STORE( int64_t, 11+imm, r2)"
												                
# RVC Compressed Instruction Set, Quadrant 1							                
   c.addi	"000 {-5}   rd   {4:0}        01"		rd.l,rd.l		C		d,Cj		"wrd(r1 + imm)"
   c.addiw	"001 {-5}   rd   {4:0}        01"		rd.w,rd.w		64,C		d,Cj		"wrd(int32_t(r1) + int32_t(imm))"
   c.jal	"001 {-11|4|9:8|10|6|7|3:1|5} 01"		-			32,C,uj,>	d,Ca		"{ wreg(1, s.pc+2); jump(s.pc+imm) }"
   c.li		"010 {-5}   rd   {4:0}        01"		rd.l			C		d,Ci		"wrd(imm)"
   c.addi16sp	"011 {-9}  00010 {4|6|8:7|5}  01"		-			C		-		"wreg(2, sp+imm)"
   c.lui	"011 {-17}  rd   {16:12}      01"		rd.l			C		d,Cu		"wrd(imm)"
   c.srli	"100 {5}   00 c1 {4:0}        01"		c1.l,c1.l		C		Cs,Cs		"wrd(r1 >> imm)"
   c.srai	"100 {5}   01 c1 {4:0}        01"		c1.l,c1.l		C		Cs,Cs		"wrd(r1 >> imm)"
   c.andi	"100 {-5}  10 c1 {4:0}        01"		c1.l,c1.l		C		Cs,Cs		"wrd(r1 & imm)"
   c.sub	"100 0     11 c1   00      c2 01"		c1.l,c1.l,c2.l		C		-		"wrd(r1 - r2)"
   c.xor	"100 0     11 c1   01      c2 01"		c1.l,c1.l,c2.l		C		-		"wrd(r1 ^ r2)"
   c.or		"100 0     11 c1   10      c2 01"		c1.l,c1.l,c2.l		C		-		"wrd(r1 | r2)"
   c.and	"100 0     11 c1   11      c2 01"		c1.l,c1.l,c2.l		C		-		"wrd(r1 & r2)"
   c.subw	"100 1     11 c1   00      c2 01"		c1.w,c1.w,c2.w		C		-		"wrd(r1 - r2)"
   c.addw	"100 1     11 c1   01      c2 01"		c1.w,c1.w,c2.w		C		-		"wrd(r1 + r2)"
   c.j		"101 {-11|4|9:8|10|6|7|3:1|5} 01"		c1.w,c1.w,c2.w		C,uj,>		-		"jump(s.pc+imm)"
   c.beqz	"110 {-8|4:3} c1 {7:6|2:1|5}  01"		-,c1.l			C,cj,>		-		"branch(r1==0, s.pc+imm, s.pc+2)"
   c.bnez	"111 {-8|4:3} c1 {7:6|2:1|5}  01"		-,c1.l			C,cj,>		-		"branch(r1!=0, s.pc+imm, s.pc+2)"
												                
# RVC Compressed Instruction Set, Quadrant 2							                
   c.slli	"000 {5}    rd  {4:0}         10"		rd.l,rd.l		C		-		"wrd(r1 << imm)"
   c.fldsp	"001 {5}    rd  {4:3|8:6}     10"		fd.d			C,D,ld		-		"wfd(f64(LOAD(uint64_t, sp+imm)))"
   c.lwsp	"010 {5}    rd  {4:2|7:6}     10"		rd.w			64,C,ld		-		"wrd(LOAD( int32_t, sp+imm))"
   c.flwsp	"011 {5}    rd  {4:2|7:6}     10"		fd.f			32,C,F,ld	-		"wfd(f32(LOAD(uint32_t, sp+imm)))"
   c.ldsp	"011 {5}    rd  {4:3|8:6}     10"		rd.l			C,ld		-		"wrd(LOAD( int64_t, sp+imm))"
#   c.ret	"100 0     00001        00000 10"		-			C,uj,>		-		"reg_jump(s.reg[1].l)"
   c.jr		"100 0      rd          00000 10"		-,rd.l			C,uj,>		-		"reg_jump(r1)"
   c.mv		"100 0      rd            cs2 10"		rd.l,cs2.l		C		-		"wrd(r1)"
   c.ebreak	"100 1     00000        00000 10"		-			C,ex		-		"ebreak()"
   c.jalr	"100 1      rd          00000 10"		-,rd.l			C,uj,>		-		"{ long npc=r1; wrd(s.pc+2); jump(npc); }"
   c.add	"100 1      rd            cs2 10"		rd.l,rd.l,cs2.l		C		-		"wrd(r1 + r2)"
   c.fsdsp	"101 {5:3|8:6}            cs2 10"		-,cs2.d			C,D,st		-		"STORE(uint64_t, sp+imm, r1.v)"
   c.swsp	"110 {5:2|7:6}            cs2 10"		-,cs2.w			C,st		-		"STORE(int32_t,  sp+imm, r1)"
   c.sdsp	"111 {5:3|8:6}            cs2 10"		-,cs2.l			64,C,st		-		"STORE(int64_t,  sp+imm, r1)"
   c.fswsp	"111 {5:2|7:6}            cs2 10"		-,cs2.f			32,C,F,st	-		"STORE(uint32_t, sp+imm, r1.v)"


#  Opcode	Instruction Bits				Registers		Flags		Assembler	Action

# RV32I Base Instruction Set
   lui		"{-31:12}                   rd    01101 11"	rd.l			I		d,u		"wrd(     imm)"
   auipc	"{-31:12}                   rd    00101 11"	rd.l			I		d,u		"wrd(s.pc+imm)"

#   j		"{-20|10:1|11|19:12}     00000    11011 11"	-			I,uj,>		a		"             jump(s.pc+imm)"
   jal		"{-20|10:1|11|19:12}        rd    11011 11"	rd.l			I,uj,>		d,a		"wrd(s.pc+4); jump(s.pc+imm)"
#   ret		"{-11:0}       00001 000 00000    11001 11"	-			I,uj,>		d,s		"reg_jump((s.reg[1].l + imm) & ~1L)"
#   jr		"{-11:0}         rs1 000 00000    11001 11"	-,rs1.l			I,uj,>		d,s		"reg_jump((r1         + imm) & ~1L)"
   jalr		"{-11:0}         rs1 000    rd    11001 11"	rd.l,rs1.l		I,uj,>		d,s		"{ long npc=(r1+imm)&~1L; wrd(s.pc+4); reg_jump(npc); }"

   beq		"{-12|10:5}  rs2 rs1 000 {4:1|11} 11000 11"	-,rs1.l,rs2.l		I,cj,>		s,t,p		"branch(r1 == r2, s.pc+imm, s.pc+4)"
   bne		"{-12|10:5}  rs2 rs1 001 {4:1|11} 11000 11"	-,rs1.l,rs2.l		I,cj,>		s,t,p		"branch(r1 != r2, s.pc+imm, s.pc+4)"
   blt		"{-12|10:5}  rs2 rs1 100 {4:1|11} 11000 11"	-,rs1.l,rs2.l		I,cj,>		s,t,p		"branch(r1 <  r2, s.pc+imm, s.pc+4)"
   bge		"{-12|10:5}  rs2 rs1 101 {4:1|11} 11000 11"	-,rs1.l,rs2.l		I,cj,>		s,t,p		"branch(r1 >= r2, s.pc+imm, s.pc+4)"
   bltu		"{-12|10:5}  rs2 rs1 110 {4:1|11} 11000 11"	-,rs1.ul,rs2.ul		I,cj,>		s,t,p		"branch(r1 <  r2, s.pc+imm, s.pc+4)"
   bgeu		"{-12|10:5}  rs2 rs1 111 {4:1|11} 11000 11"	-,rs1.ul,rs2.ul		I,cj,>		s,t,p		"branch(r1 >= r2, s.pc+imm, s.pc+4)"

   lb		"{-11:0}         rs1 000    rd    00000 11"	rd.l,rs1.l		I,ld		d,o(s)		"wrd(LOAD( int8_t,  r1+imm))"
   lh		"{-11:0}         rs1 001    rd    00000 11"	rd.l,rs1.l		I,ld		d,o(s)		"wrd(LOAD( int16_t, r1+imm))"
   lw		"{-11:0}         rs1 010    rd    00000 11"	rd.l,rs1.l		I,ld		d,o(s)		"wrd(LOAD( int32_t, r1+imm))"
   lbu		"{-11:0}         rs1 100    rd    00000 11"	rd.ul,rs1.l		I,ld		d,o(s)		"wrd(LOAD(uint8_t,  r1+imm))"
   lhu		"{-11:0}         rs1 101    rd    00000 11"	rd.ul,rs1.l		I,ld		d,o(s)		"wrd(LOAD(uint16_t, r1+imm))"
   sb		"{-11:5}     rs2 rs1 000 {4:0}    01000 11"	-,rs1.l,rs2.l		I,st		t,q(s)		"STORE(int8_t,  r1+imm, r2)"
   sh		"{-11:5}     rs2 rs1 001 {4:0}    01000 11"	-,rs1.l,rs2.l		I,st		t,q(s)		"STORE(int16_t, r1+imm, r2)"
   sw		"{-11:5}     rs2 rs1 010 {4:0}    01000 11"	-,rs1.l,rs2.l		I,st		t,q(s)		"STORE(int32_t, r1+imm, r2)"

   addi		"{-11:0}         rs1 000    rd    00100 11"	rd.l,rs1.l		I		d,s,j		"wrd(r1 +  imm)"
   slti		"{-11:0}         rs1 010    rd    00100 11"	rd.l,rs1.l		I		d,s,j		"wrd(r1 <  imm)"
   sltiu	"{-11:0}         rs1 011    rd    00100 11"	rd.l,rs1.l		I		d,s,j		"wrd(r1 < uimm)"
   xori		"{-11:0}         rs1 100    rd    00100 11"	rd.l,rs1.l		I		d,s,j		"wrd(r1 ^  imm)"
   ori		"{-11:0}         rs1 110    rd    00100 11"	rd.l,rs1.l		I		d,s,j		"wrd(r1 |  imm)"
   andi		"{-11:0}         rs1 111    rd    00100 11"	rd.l,rs1.l		I		d,s,j		"wrd(r1 &  imm)"
   slli		"000000   {5:0}  rs1 001    rd    00100 11"	rd.l,rs1.l		I		d,s,>		"wrd(r1 << imm)"
   srli		"000000   {5:0}  rs1 101    rd    00100 11"	rd.ul,rs1.ul		I		d,s,>		"wrd(r1 >> imm)"
   srai		"010000   {5:0}  rs1 101    rd    00100 11"	rd.l,rs1.l		I		d,s,>		"wrd(r1 >> imm)"

   add		"0000000     rs2 rs1 000    rd    01100 11"	rd.l,rs1.l,rs2.l	I		d,s,t		"wrd(r1 + r2)"
   sub		"0100000     rs2 rs1 000    rd    01100 11"	rd.l,rs1.l,rs2.l	I		d,s,t		"wrd(r1 - r2)"
   sll		"0000000     rs2 rs1 001    rd    01100 11"	rd.l,rs1.l,rs2.l	I		d,s,t		"wrd(r1 << r2)"
   slt		"0000000     rs2 rs1 010    rd    01100 11"	rd.l,rs1.l,rs2.l	I		d,s,t		"wrd(r1 <  r2)"
   sltu		"0000000     rs2 rs1 011    rd    01100 11"	rd.ul,rs1.ul,rs2.ul	I		d,s,t		"wrd(r1 <  r2)"
   xor		"0000000     rs2 rs1 100    rd    01100 11"	rd.l,rs1.l,rs2.l	I		d,s,t		"wrd(r1 ^  r2)"
   srl		"0000000     rs2 rs1 101    rd    01100 11"	rd.ul,rs1.ul,rs2.ul	I		d,s,t		"wrd(r1 >> r2)"
   sra		"0100000     rs2 rs1 101    rd    01100 11"	rd.l,rs1.l,rs2.l	I		d,s,t		"wrd(r1 >> r2)"
   or		"0000000     rs2 rs1 110    rd    01100 11"	rd.l,rs1.l,rs2.l	I		d,s,t		"wrd(r1 |  r2)"
   and		"0000000     rs2 rs1 111    rd    01100 11"	rd.l,rs1.l,rs2.l	I		d,s,t		"wrd(r1 &  r2)"

   fence	"{11:0}          rs1 000    rd    00011 11"	rd.l,rs1.l		<,I,ex,>	d,s,j		"fence(imm)"
   fence.i	"{11:0}          rs1 001    rd    00011 11"	rd.l,rs1.l		<,I,ex,>	d,s,j		"fence_i(imm)"
   ecall	"000000000000  00000 000  00000   11100 11"	-			<,I,ex,>	-		"wreg(10, riscv_syscall(this, rreg(10)))"
   ebreak	"000000000001  00000 000  00000   11100 11"	-			I,ex		-		"ebreak()"

   csrrw	"{11:0}          rs1 001    rd    11100 11"	rd.l,rs1.l		<,I,sr,>	d,E,s		"wrd(csr_func(imm,       [&](uxlen_t old) { return        r1;        } ))"
   csrrs	"{11:0}          rs1 010    rd    11100 11"	rd.l,rs1.l		<,I,sr,>	d,E,s		"wrd(csr_func(imm,       [&](uxlen_t old) { return old |  r1;        } ))"
   csrrc	"{11:0}          rs1 011    rd    11100 11"	rd.l,rs1.l		<,I,sr,>	d,E,s		"wrd(csr_func(imm,       [&](uxlen_t old) { return old & ~r1;        } ))"
   csrrwi	"{11:0}      {16:12} 101    rd    11100 11"	rd.l,rs1.l		<,I,sr,>	d,E,Z		"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return        (uimm>>12); } ))"
   csrrsi	"{11:0}      {16:12} 110    rd    11100 11"	rd.l,rs1.l		<,I,sr,>	d,E,Z		"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return old |  (uimm>>12); } ))"
   csrrci	"{11:0}      {16:12} 111    rd    11100 11"	rd.l,rs1.l		<,I,sr,>	d,E,Z		"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return old & ~(uimm>>12); } ))"


# RV64I Base Instruction Set (in addition to RV32I)
   lwu		"{-11:0}         rs1 110    rd    00000 11"	rd.kuw,rs1.l		64,I,ld		d,o(s)		"wrd(LOAD(uint32_t, r1+imm))"
   ld		"{-11:0}         rs1 011    rd    00000 11"	rd.l,rs1.l		64,I,ld		d,o(s)		"wrd(LOAD(int64_t,  r1+imm))"
   sd		"{-11:5}     rs2 rs1 011 {4:0}    01000 11"	-,rs1.l,rs2.l		64,I,st		t,q(s)		"STORE(int64_t, r1+imm, r2)"

   addiw	"{-11:0}         rs1 000    rd    00110 11"	rd.l,rs1.l		64,I		d,s,j		"wrd( int32_t(r1) +  int32_t(imm))"
   slliw	"0000000  {4:0}  rs1 001    rd    00110 11"	rd.l,rs1.l		64,I		d,s,<		"wrd( int32_t(r1) << int32_t(imm))"
   srliw	"0000000  {4:0}  rs1 101    rd    00110 11"	rd.l,rs1.l		64,I		d,s,<		"wrd(uint32_t(r1) >> int32_t(imm))"
   sraiw	"0100000  {4:0}  rs1 101    rd    00110 11"	rd.l,rs1.l		64,I		d,s,<		"wrd( int32_t(r1) >> int32_t(imm))"

   addw		"0000000     rs2 rs1 000    rd    01110 11"	rd.w,rs1.w,rs2.w	64,I		d,s,t		"wrd( int32_t(r1) +   int32_t(r2))"
   subw		"0100000     rs2 rs1 000    rd    01110 11"	rd.w,rs1.w,rs2.w	64,I		d,s,t		"wrd( int32_t(r1) -   int32_t(r2))"
   sllw		"0000000     rs2 rs1 001    rd    01110 11"	rd.w,rs1.w,rs2.w	64,I		d,s,t		"wrd( int32_t(r1) <<  int32_t(r2))"
   srlw		"0000000     rs2 rs1 101    rd    01110 11"	rd.w,rs1.w,rs2.w	64,I		d,s,t		"wrd(uint32_t(r1) >>  int32_t(r2))"
   sraw		"0100000     rs2 rs1 101    rd    01110 11"	rd.w,rs1.w,rs2.w	64,I		d,s,t		"wrd( int32_t(r1) >>  int32_t(r2))"


# RV32M Standard Extension
   mul		"0000001     rs2 rs1 000    rd    01100 11"	rd.l,rs1.l,rs2.l	M		d,s,t		"wrd(r1 * r2)"
   mulh		"0000001     rs2 rs1 001    rd    01100 11"	rd.l,rs1.l,rs2.l	M		d,s,t		"wrd(mulh  (r1, r2))"
   mulhsu	"0000001     rs2 rs1 010    rd    01100 11"	rd.l,rs1.l,rs2.l	M		d,s,t		"wrd(mulhsu(r1, r2))"
   mulhu	"0000001     rs2 rs1 011    rd    01100 11"	rd.l,rs1.l,rs2.l	M		d,s,t		"wrd(mulhu (r1, r2))"
   div		"0000001     rs2 rs1 100    rd    01100 11"	rd.l,rs1.l,rs2.l	M		d,s,t		"wrd(r2==0 ? ~0L : r1/r2)"
   divu		"0000001     rs2 rs1 101    rd    01100 11"	rd.ul,rs1.ul,rs2.ul	M		d,s,t		"wrd(r2==0 ? ~0L : r1/r2)"
   rem		"0000001     rs2 rs1 110    rd    01100 11"	rd.l,rs1.l,rs2.l	M		d,s,t		"wrd(r2==0 ?  r1 : r1%r2)"
   remu		"0000001     rs2 rs1 111    rd    01100 11"	rd.ul,rs1.ul,rs2.ul	M		d,s,t		"wrd(r2==0 ?  r1 : r1%r2)"


# RV64M Standard Extension (in addition to RV32M)
   mulw		"0000001     rs2 rs1 000    rd    01110 11"	rd.w,rs1.w,rs2.w	64,M		d,s,t		"wrd((int32_t)r1 * (int32_t)r2)"
   divw		"0000001     rs2 rs1 100    rd    01110 11"	rd.w,rs1.w,rs2.w	64,M		d,s,t		"wrd(r2==0 ? UINT64_MAX : ( int32_t)r1/( int32_t)r2)"
   divuw	"0000001     rs2 rs1 101    rd    01110 11"	rd.uw,rs1.uw,rs2.uw	64,M		d,s,t		"wrd(r2==0 ? UINT64_MAX : (uint32_t)r1/(uint32_t)r2)"
   remw		"0000001     rs2 rs1 110    rd    01110 11"	rd.w,rs1.w,rs2.w	64,M		d,s,t		"wrd(r2==0 ? UINT64_MAX : ( int32_t)r1%( int32_t)r2)"
   remuw	"0000001     rs2 rs1 111    rd    01110 11"	rd.uw,rs1.uw,rs2.uw	64,M		d,s,t		"wrd(r2==0 ? UINT64_MAX : (uint32_t)r1%(uint32_t)r2)"


# RV32A Standard Extension
   lr.w		"00010 {1:0} 00000 rs1 010  rd    01011 11"	rd.w,rs1.l		A,amo,ld	d,0(s)		"wrd(load_reserved(int32_t, r1))"
   sc.w		"00011 {1:0} rs2 rs1 010    rd    01011 11"	rd.l,rs1.l,rs2.l	A,amo,st,>	d,t,0(s)	"wrd(store_conditional(int32_t, r1, r2))"
   amoswap.w	"00001 {1:0} rs2 rs1 010    rd    01011 11"	rd.w,rs1.l,rs2.w	A,amo,rmw,>	d,t,0(s)	"wrd(amo_int32(r1, [&](int32_t lhs) { return       r2; }, ap))"
