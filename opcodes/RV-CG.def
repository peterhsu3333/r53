w!#  Opcode	Assembler	Attributes		     Instruction Format				Register Fields	C++ Semantics

# RVC Compressed Instruction Set, Quadrant 0

   c.addi4spn	Ct,Cc,CK	C			     "000 {5:4|9:6|2|3}        ... 00"		lc2,2,-,-	"wrd(r1+imm)"
   c.fld	CD,Cl(Cs)	C,D,ld			     "001 {5:3}    ... {7:6}   ... 00"		dc2,lc1,-,-	"wdd(LOAD(double,  r1+imm))"
   c.lw		Ct,Cl(Cs)	C,ld			     "010 {5:3}    ... {2|6}   ... 00"		wc2,lc1,-,-	"wrd(LOAD(int32_t, r1+imm))"
   c.ld		Ct,Cl(Cs)	64,C,ld			     "011 {5:3}    ... {7:6}   ... 00"		lc2,lc1,-,-	"wrd(LOAD(int64_t, r1+imm))"
   c.flw	Ct,Cl(Cs)	32,C,F,ld		     "011 {5:3}    ... {2|6}   ... 00"		fc2,lc1,-,-	"wfd(LOAD( float,  r1+imm))"
   c.fsd	CD,Cl(Cs)	C,D,st			     "101 {5:3}    ... {7:6}   ... 00"		-,lc1,fc2,-	"STORE(double,   r1+imm, d2)"
   c.sw		Ct,Cl(Cs)	C,st			     "110 {5:3}    ... {2|6}   ... 00"		-,lc1,wc2,-	"STORE(int32_t,  r1+imm, r2)"
   c.sd		Ct,Cl(Cs)	C,st			     "111 {5:3}    ... {7:6}   ... 00"		-,lc1,lc2,-	"STORE(int64_t,  r1+imm, r2)"

# RVC Compressed Instruction Set, Quadrant 1

   c.addi	rd		C			     "000 {-5}   ..... {4:0}       01"		lrd,lrd,-,-	"wrd(r1 + imm)"
   c.addiw	rd		64,C			     "001 {-5}   ..... {4:0}       01"		wrd,lrd,-,-	"wrd(int32_t(r1) + int32_t(imm))"
   c.jal	-		32,C,uj,>		     "001 {-11|4|9:8|10|6|7|3:1|5} 01"		1,-,-,-		"{ wrd(s.pc+2); jump(s.pc+imm) }"
   c.li		rd		C			     "010 {-5}   ..... {4:0}       01"		lrd,-,-,-	"wrd(imm)"
   c.addi16sp	-		C		     	     "011 {-9}   00010 {4|6|8:7|5} 01"		2,2,-,-		"wrd(r1+imm)"
   c.lui	rd		C			     "011 {-17}  ..... {16:12}     01"		lrd,-		"wrd(imm)"
   c.srli	rd		C			     "100 {5}   00 ... {4:0}       01"		lc1,lc1,-,-	"wrd(uint64_t(r1) >> imm)"
   c.srai	rd		C			     "100 {5}   01 ... {4:0}       01"		lc1,lc1,-,-	"wrd( int64_t(r1) >> imm)"
   c.andi	rd		C			     "100 {-5}  10 ... {4:0}       01"		lc1,lc1,-,-	"wrd(r1 & imm)"
   c.sub	rd,rs2		C			     "100 0     11 ...      00 ... 01"		lc1,lc1,lc2,-	"wrd(r1 - r2)"
   c.xor	rd,rs2		C			     "100 0     11 ...      01 ... 01"		lc1,lc1,lc2,-	"wrd(r1 ^ r2)"
   c.or		rd,rs2		C			     "100 0     11 ...      10 ... 01"		lc1,lc1,lc2,-	"wrd(r1 | r2)"
   c.and	rd,rs2		C			     "100 0     11 ...      11 ... 01"		lc1,lc1,lc2,-	"wrd(r1 & r2)"
   c.subw	rd,rs2		C			     "100 1     11 ...      00 ... 01"		wc1,wc1,wc2,-	"wrd(int32_t(r1) - int32_t(r2))"
   c.addw	rd,rs2		C			     "100 1     11 ...      01 ... 01"		wc1,wc1,wc2,-	"wrd(int32_t(r1) + int32_t(r2))"
   c.j		-		C,uj,>			     "101 {-11|4|9:8|10|6|7|3:1|5} 01"		-,-,-,-		"jump(s.pc+imm)"
   c.beqz	rs1		C,cj,>			     "110 {-8|4:3} ... {7:6|2:1|5} 01"		-,lc1,-,-	"branch(r1==0, s.pc+imm, s.pc+2)"
   c.bnez	rs1		C,cj,>			     "111 {-8|4:3} ... {7:6|2:1|5} 01"		-,lc1,-,-	"branch(r1!=0, s.pc+imm, s.pc+2)"

# RVC Compressed Instruction Set, Quadrant 1

   c.slli	rd		C			     "000 {5}    ..... {4:0}       10"		lrd,lrd,-,-	"wrd(uint64_t(r1) << imm)"
   c.fldsp	fd		C,D,ld			     "001 {5}    ..... {4:3|8:6}   10"		drd,2,-,-	"wdd(LOAD(double,  r1+imm))"
   c.lwsp	rd		64,C,ld			     "010 {5}    ..... {4:2|7:6}   10"		wrd,2,-,-	"wrd(LOAD(int32_t, r1+imm))"
   c.flwsp	rd		32,C,F,ld		     "011 {5}    ..... {4:2|7:6}   10"		frd,2,-,-	"wfd(LOAD(float,   r1+imm))"
   c.ldsp	rd		C,ld			     "011 {5}    ..... {4:3|8:6}   10"		lrd,2,-,-	"wrd(LOAD(int64_t, r1+imm))"
   c.ret	rs1		C,uj,>			     "100 0      00001       00000 10"		-,1,-,-		"reg_jump(r1)"
   c.jr		rs1		C,uj,>			     "100 0      .....       00000 10"		-,lrd,-,-	"reg_jump(r1)"
   c.mv		rd,rs2		C			     "100 0      .....       ..... 10"		lrd,-,lc3,-	"wrd(r2)"
   c.ebreak	-		C,ex			     "100 1      00000       00000 10"		-,-,-,-		"ebreak()"
   c.jalr	rs1		C,uj,>			     "100 1      .....       00000 10"		1,lrd,-,-	"{ long npc=r1; wrd(s.pc+2); jump(npc); }"

   c.add	rd,rs2		C			     "100 1      .....       ..... 10"		lrd,lrd,lc3,-	"wrd(r1 + r2)"
   c.fsdsp	fs2		C,D,st			     "101 {5:3|8:6}          ..... 10"		-,2,dc3,-	"STORE(double,  r1+imm, d2)"
   c.swsp	rs2		C,st			     "110 {5:2|7:6}          ..... 10"		-,2,wc3,-	"STORE(int32_t, r1+imm, r2)"
   c.sdsp	rs2		64,C,st			     "111 {5:3|8:6}          ..... 10"		-,2,lc3,-	"STORE(int64_t, r1+imm, r2)"
   c.fswsp	rs2		32,C,F,st		     "111 {5:2|7:6}          ..... 10"		-,2,fc3,-	"STORE(float,   r1+imm, f2)"

# RV32I Base Instruction Set

   lui		d,u		I		"{-31:12}                      ..... 01101 11"		lrd,-		"wrd(   imm)"
   auipc	d,u		I		"{-31:12}                      ..... 00101 11"		lrd,-		"wrd(s.pc+imm)"

   j		a		I,uj,>		"{-20|10:1|11|19:12}           00000 11011 11"		lrd,-		"           jump(s.pc+imm)"
   jal		d,a		I,uj,>		"{-20|10:1|11|19:12}           ..... 11011 11"		lrd,-		"wrd(s.pc+4); jump(s.pc+imm)"
   ret		d,s		I,uj,>		"{-11:0}           ..... 000   00000 11001 11"		-,ls1,-,-	"reg_jump((r1+imm)&~1L)"
   jalr		d,s		I,uj,>		"{-11:0}           ..... 000   ..... 11001 11"		lrd,ls1,-,-	"{ long npc=(r1+imm)&~1L; wrd(s.pc+4); reg_jump(npc); }"

   beq		s,t,p		I,cj,>		"{-12|10:5}  ..... ..... 000 {4:1|11} 1100011"		-,ls1,ls2,-	"branch(r1 == r2, s.pc+imm, s.pc+4)"
   bne		s,t,p		I,cj,>		"{-12|10:5}  ..... ..... 001 {4:1|11} 1100011"		-,ls1,ls2,-	"branch(r1 != r2, s.pc+imm, s.pc+4)"
   blt		s,t,p		I,cj,>		"{-12|10:5}  ..... ..... 100 {4:1|11} 1100011"		-,ls1,ls2,-	"branch(r1 <  r2, s.pc+imm, s.pc+4)"
   bge		s,t,p		I,cj,>		"{-12|10:5}  ..... ..... 101 {4:1|11} 1100011"		-,ls1,ls2,-	"branch(r1 >= r2, s.pc+imm, s.pc+4)"
   bltu		s,t,p		I,cj,>		"{-12|10:5}  ..... ..... 110 {4:1|11} 1100011"		-,ls1,ls2,-	"branch(u1 <  u2, s.pc+imm, s.pc+4)"
   bgeu		s,t,p		I,cj,>		"{-12|10:5}  ..... ..... 111 {4:1|11} 1100011"		-,ls1,ls2,-	"branch(u1 >= u2, s.pc+imm, s.pc+4)"

   lb		d,o(s)		I,ld		"{-11:0}           ..... 000   ..... 00000 11"		brd,ls1,-,-	"wrd(LOAD( int8_t,  r1+imm))"
   lh		d,o(s)		I,ld		"{-11:0}           ..... 001   ..... 00000 11"		hrd,ls1,-,-	"wrd(LOAD( int16_t, r1+imm))"
   lw		d,o(s)		I,ld		"{-11:0}           ..... 010   ..... 00000 11"		wrd,ls1,-,-	"wrd(LOAD( int32_t, r1+imm))"
   lbu		d,o(s)		I,ld		"{-11:0}           ..... 100   ..... 00000 11"		ubrd,ls1,-,-	"wud(LOAD(uint8_t,  r1+imm))"
   lhu		d,o(s)		I,ld		"{-11:0}           ..... 101   ..... 00000 11"		uhrd,ls1,-,-	"wud(LOAD(uint16_t, r1+imm))"
   sb		t,q(s)		I,st		"{-11:5}     ..... ..... 000   {4:0} 01000 11"		-,ls1,bs2,-	"STORE(int8_t,  r1+imm, r2)"
   sh		t,q(s)		I,st		"{-11:5}     ..... ..... 001   {4:0} 01000 11"		-,ls1,hs2,-	"STORE(int16_t, r1+imm, r2)"
   sw		t,q(s)		I,st		"{-11:5}     ..... ..... 010   {4:0} 01000 11"		-,ls1,ws2,-	"STORE(int32_t, r1+imm, r2)"

   addi		d,s,j		I		"{-11:0}           ..... 000   ..... 00100 11"		lrd,ls1,-,-	"wrd(r1 +  imm)"
   slti		d,s,j		I		"{-11:0}           ..... 010   ..... 00100 11"		lrd,ls1,-,-	"wrd(r1 <  imm)"
   sltiu	d,s,j		I		"{-11:0}           ..... 011   ..... 00100 11"		lrd,ls1,-,-	"wud(u1 < uimm)"
   xori		d,s,j		I		"{-11:0}           ..... 100   ..... 00100 11"		lrd,ls1,-,-	"wud(u1 ^ uimm)"
   ori		d,s,j		I		"{-11:0}           ..... 110   ..... 00100 11"		lrd,ls1,-,-	"wud(u1 | uimm)"
   andi		d,s,j		I		"{-11:0}           ..... 111   ..... 00100 11"		lrd,ls1,-,-	"wud(u1 & uimm)"
   slli		d,s,>		I		"000000      {5:0} ..... 001   ..... 00100 11"		lrd,ls1,-,-	"wud(u1 << imm)"
   srli		d,s,>		I		"000000      {5:0} ..... 101   ..... 00100 11"		lrd,ls1,-,-	"wud(u1 >> imm)"
   srai		d,s,>		I		"010000      {5:0} ..... 101   ..... 00100 11"		lrd,ls1,-,-	"wrd(r1 >> imm)"

   add		d,s,t		I		"0000000     ..... ..... 000   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r1 + r2)"
   sub		d,s,t		I		"0100000     ..... ..... 000   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r1 - r2)"
   sll		d,s,t		I		"0000000     ..... ..... 001   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(u1 << u2)"
   slt		d,s,t		I		"0000000     ..... ..... 010   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r1 <  r2)"
   sltu		d,s,t		I		"0000000     ..... ..... 011   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(u1 <  u2)"
   xor		d,s,t		I		"0000000     ..... ..... 100   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(u1 ^  u2)"
   srl		d,s,t		I		"0000000     ..... ..... 101   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(u1 >> u2)"
   sra		d,s,t		I		"0100000     ..... ..... 101   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r1 >> r2)"
   or		d,s,t		I		"0000000     ..... ..... 110   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(u1 |  u2)"
   and		d,s,t		I		"0000000     ..... ..... 111   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(u1 &  u2)"
b
   fence	rd,rs1		<,I,ex,>	"{11:0}            ..... 000   ..... 00011 11"		lrd,ls1,-,-	"fence(imm)"
   fence.i	rd,rs1		<,I,ex,>	"{11:0}            ..... 001   ..... 00011 11"		lrd,ls1,-,-	"fence_i(imm)"
   ecall	-		<,I,ex,>	"000000000000      00000 000   00000 11100 11"		10,10,-,-	"wrd(riscv_syscall(this, r1))"
   ebreak	-		I,ex		"000000000001      00000 000   00000 11100 11"		-,-,-,-		"ebreak()"

   csrrw	d,E,s		<,I,sr,>	"{11:0}            ..... 001   ..... 11100 11"		lrd,ls1,-,-	"wrd(csr_func(imm,       [&](uxlen_t old) { return        u1;        } ))"
   csrrs	d,E,s		<,I,sr,>	"{11:0}            ..... 010   ..... 11100 11"		lrd,ls1,-,-	"wrd(csr_func(imm,       [&](uxlen_t old) { return old |  u1;        } ))"
   csrrc	d,E,s		<,I,sr,>	"{11:0}            ..... 011   ..... 11100 11"		lrd,ls1,-,-	"wrd(csr_func(imm,       [&](uxlen_t old) { return old & ~u1;        } ))"
   csrrwi	d,E,Z		<,I,sr,>	"{11:0}          {16:12} 101   ..... 11100 11"		lrd,-,-,-	"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return        (uimm>>12); } ))"
   csrrsi	d,E,Z		<,I,sr,>	"{11:0}          {16:12} 110   ..... 11100 11"		lrd,-,-,-	"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return old |  (uimm>>12); } ))"
   csrrci	d,E,Z		<,I,sr,>	"{11:0}          {16:12} 111   ..... 11100 11"		lrd,-,-,-	"wrd(csr_func(imm&0xFFF, [&](uxlen_t old) { return old & ~(uimm>>12); } ))"

# RV64I Base Instruction Set (in addition to RV32I)

   lwu		d,o(s)		64,I,ld		"{-11:0}           ..... 110   ..... 00000 11"		wurd,ls1,-,-	"wrd(LOAD(uint32_t, r1+imm))"
   ld		d,o(s)		64,I,ld		"{-11:0}           ..... 011   ..... 00000 11"		lulrd,ls1,-,-	"wrd(LOAD(int64_t,  r1+imm))"
   sd		t,q(s)		64,I,st		"{-11:5}     ..... ..... 011   {4:0} 01000 11"		-,ls1,ls2,-	"STORE(int64_t, r1+imm, r2)"

   addiw	d,s,j		64,I		"{-11:0}           ..... 000   ..... 00110 11"		wrd,ws1,-,-	"wrd( int32_t(r1) +  int32_t(imm))"
   slliw	d,s,<		64,I		"0000000     {4:0} ..... 001   ..... 00110 11"		wrd,ws1,-,-	"wrd(uint32_t(r1) << imm)"
   srliw	d,s,<		64,I		"0000000     {4:0} ..... 101   ..... 00110 11"		wrd,ws1,-,-	"wrd(uint32_t(r1) >> imm)"
   sraiw	d,s,<		64,I		"0100000     {4:0} ..... 101   ..... 00110 11"		wrd,ws1,-,-	"wrd( int32_t(r1) >> imm)"

   addw		d,s,t		64,I		"0000000     ..... ..... 000   ..... 01110 11"		wrd,ws1,ws2,-	"wrd( int32_t(r1) +   int32_t(r2))"
   subw		d,s,t		64,I		"0100000     ..... ..... 000   ..... 01110 11"		wrd,ws1,ws2,-	"wrd( int32_t(r1) -   int32_t(r2))"
   sllw		d,s,t		64,I		"0000000     ..... ..... 001   ..... 01110 11"		wrd,ws1,ws2,-	"wrd(uint32_t(r1) << uint32_t(r2))"
   srlw		d,s,t		64,I		"0000000     ..... ..... 101   ..... 01110 11"		wrd,ws1,ws2,-	"wrd(uint32_t(r1) >> uint32_t(r2))"
   sraw		d,s,t		64,I		"0100000     ..... ..... 101   ..... 01110 11"		wrd,ws1,ws2,-	"wrd( int32_t(r1) >>  int32_t(r2))"

# RV32M Standard Extension

   mul		d,s,t		M		"0000001     ..... ..... 000   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r1 * r2)"
   mulh		d,s,t		M		"0000001     ..... ..... 001   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(mulh  (r1, r2))"
   mulhsu	d,s,t		M		"0000001     ..... ..... 010   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(mulhsu(r1, r2))"
   mulhu	d,s,t		M		"0000001     ..... ..... 011   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(mulhu (r1, r2))"
   div		d,s,t		M		"0000001     ..... ..... 100   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r2==0 ?  INT64_MAX : (r1==INT64_MIN && r2==-1) ? r1 : r1/r2)"
   divu		d,s,t		M		"0000001     ..... ..... 101   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r2==0 ? UINT64_MAX : (uint64_t)r1/(uint64_t)r2             )"
   rem		d,s,t		M		"0000001     ..... ..... 110   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r2==0 ?  INT64_MAX : (r1==INT64_MIN && r2==-1) ? r1 : r1%r2)"
   remu		d,s,t		M		"0000001     ..... ..... 111   ..... 01100 11"		lrd,ls1,ls2,-	"wrd(r2==0 ? UINT64_MAX : (uint64_t)r1%(uint64_t)r2             )"

# RV64M Standard Extension (in addition to RV32M)

   mulw		d,s,t		64,M		"0000001     ..... ..... 000   ..... 01110 11"		wrd,ws1,ws2,-	"wrd((int32_t)r1 * (int32_t)r2)"
   divw		d,s,t		64,M		"0000001     ..... ..... 100   ..... 01110 11"		wrd,ws1,ws2,-	"wrd(r2==0 ? UINT64_MAX : ( int32_t)r1/( int32_t)r2)"
   divuw	d,s,t		64,M		"0000001     ..... ..... 101   ..... 01110 11"		wrd,ws1,ws2,-	"wrd(r2==0 ? UINT64_MAX : (uint32_t)r1/(uint32_t)r2)"
   remw		d,s,t		64,M		"0000001     ..... ..... 110   ..... 01110 11"		wrd,ws1,ws2,-	"wrd(r2==0 ? UINT64_MAX : ( int32_t)r1%( int32_t)r2)"
   remuw	d,s,t		64,M		"0000001     ..... ..... 111   ..... 01110 11"		wrd,ws1,ws2,-	"wrd(r2==0 ? UINT64_MAX : (uint32_t)r1%(uint32_t)r2)"

# RV32A Standard Extension

   lr.w		d,0(s)		A,amo,ld	"00010 {1:0} 00000 ..... 010   ..... 01011 11"		wrd,ls1,-,-	"wrd(load_reserved(int32_t, r1))"
   sc.w		d,t,0(s)	A,amo,st,>	"00011 {1:0} ..... ..... 010   ..... 01011 11"		lrd,ls1,ws2,-	"wrd(store_conditional(int32_t, r1, r2))"
   amoswap.w	d,t,0(s)	A,amo,rmw,>	"00001 {1:0} ..... ..... 010   ..... 01011 11"		wrd,ls1,ws2,-	"wrd(amo_int32(r1, [&](int32_t lhs) { return       r2; }, ap))"
   amoadd.w	d,t,0(s)	A,amo,rmw,>	"00000 {1:0} ..... ..... 010   ..... 01011 11"		wrd,ls1,ws2,-	"wrd(amo_int32(r1, [&](int32_t lhs) { return lhs + r2; }, ap))"
   amoxor.w	d,t,0(s)	A,amo,rmw,>	"00100 {1:0} ..... ..... 010   ..... 01011 11"		wrd,ls1,ws2,-	"wrd(amo_int32(r1, [&](int32_t lhs) { return lhs ^ r2; }, ap))"
   amoand.w	d,t,0(s)	A,amo,rmw,>	"01100 {1:0} ..... ..... 010   ..... 01011 11"		wrd,ls1,ws2,-	"wrd(amo_int32(r1, [&](int32_t lhs) { return lhs & r2; }, ap))"
   amoor.w	d,t,0(s)	A,amo,rmw,>	"01000 {1:0} ..... ..... 010   ..... 01011 11"		wrd,ls1,ws2,-	"wrd(amo_int32(r1, [&](int32_t lhs) { return lhs | r2; }, ap))"
   amomin.w	d,t,0(s)	A,amo,rmw,>	"10000 {1:0} ..... ..... 010   ..... 01011 11"		wrd,ls1,ws2,-	"wrd(amo_int32(r1, [&](int32_t lhs) { return std::min(lhs, (int32_t)r2); }, ap))"
   amomax.w	d,t,0(s)	A,amo,rmw,>	"10100 {1:0} ..... ..... 010   ..... 01011 11"		wrd,ls1,ws2,-	"wrd(amo_int32(r1, [&](int32_t lhs) { return std::max(lhs, (int32_t)r2); }, ap))"
   amominu.w	d,t,0(s)	A,amo,rmw,>	"11000 {1:0} ..... ..... 010   ..... 01011 11"		wrd,ls1,ws2,-	"wrd((uint32_t)amo_int32(r1, [&](uint32_t lhs) { return std::min(lhs, (uint32_t)r2); }, ap))"
