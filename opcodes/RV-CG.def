# Internal instructions to emulate Compare-And-Swap
   cas.w	d,t,0(s),r	A,amo,rmw,>	"..... 10    ..... ..... 111   ..... 11111 11"		wrd,ls1,ws2,ws3	"wrd(cas32(r1, r2, r3, ap))"
