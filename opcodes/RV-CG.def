   fmax.s	D,S,T		F,fp		"00101 00    ..... ..... 001   ..... 10100 11"		frd,fs1,fs2,-	"     wfd(std::max(f1, f2))"

   feq.s	d,S,T		F,fp		"10100 00    ..... ..... 010   ..... 10100 11"		lrd,fs1,fs2,-	"     wrd(f1 == f2)"
   flt.s	d,S,T		F,fp		"10100 00    ..... ..... 001   ..... 10100 11"		lrd,fs1,fs2,-	"     wrd(f1 <  f2)"
