# RV32F Standard Extension

   flw		D,o(s)		F,ld		"{-11:0}           ..... 010   ..... 00001 11"		frd,ls1,-,-	"wfd(LOAD(float, r1+imm))"
   fsw		T,q(s)		F,st		"{-11:5}     ..... ..... 010   {4:0} 01001 11"		-,ls1,fs2,-	"STORE(float, r1+imm, f2)"

   fmadd.s	D,S,T,R,m	F,fp		"..... 00    ..... ..... 111   ..... 10000 11"		frd,fs1,fs2,fs3	"wfd( f1 * f2 + f3)" 
   fmsub.s	D,S,T,R,m	F,fp		"..... 00    ..... ..... 111   ..... 10001 11"		frd,fs1,fs2,fs3	"wfd( f1 * f2 - f3)"
   fnmsub.s	D,S,T,R,m	F,fp		"..... 00    ..... ..... 111   ..... 10010 11"		frd,fs1,fs2,fs3	"wfd(-f1 * f2 + f3)"
   fnmadd.s	D,S,T,R,m	F,fp		"..... 00    ..... ..... 111   ..... 10011 11"		frd,fs1,fs2,fs3	"wfd(-f1 * f2 - f3)"
																	                                     
   fadd.s	D,S,T,m		F,fp		"00000 00    ..... ..... 111   ..... 10100 11"		frd,fs1,fs2,-	"wfd(f1 + f2)"	     
   fsub.s	D,S,T,m		F,fp		"00001 00    ..... ..... 111   ..... 10100 11"		frd,fs1,fs2,-	"wfd(f1 - f2)"	     
   fmul.s	D,S,T,m		F,fp		"00010 00    ..... ..... 111   ..... 10100 11"		frd,fs1,fs2,-	"wfd(f1 * f2)"	     
   fdiv.s	D,S,T,m		F,fp		"00011 00    ..... ..... 111   ..... 10100 11"		frd,fs1,fs2,-	"wfd(f1 / f2)"	     
   fsqrt.s	D,S,m		F,fp		"01011 00    00000 ..... 111   ..... 10100 11"		frd,fs1,-,-	"wfd(std::sqrt(f1))"        

   fmadd.s.rm	D,S,T,R,m	F,fp		"..... 00    ..... ..... {2:0} ..... 10000 11"		frd,fs1,fs2,fs3	"srm; wfd( f1 * f2 + f3); sfx"
   fmsub.s.rm	D,S,T,R,m	F,fp		"..... 00    ..... ..... {2:0} ..... 10001 11"		frd,fs1,fs2,fs3	"srm; wfd( f1 * f2 - f3); sfx"
   fnmsub.s.rm	D,S,T,R,m	F,fp		"..... 00    ..... ..... {2:0} ..... 10010 11"		frd,fs1,fs2,fs3	"srm; wfd(-f1 * f2 + f3); sfx"
   fnmadd.s.rm	D,S,T,R,m	F,fp		"..... 00    ..... ..... {2:0} ..... 10011 11"		frd,fs1,fs2,fs3	"srm; wfd(-f1 * f2 - f3); sfx"

   fadd.s.rm	D,S,T,m		F,fp		"00000 00    ..... ..... {2:0} ..... 10100 11"		frd,fs1,fs2,-	"srm; wfd(f1 + f2);       sfx"
   fsub.s.rm	D,S,T,m		F,fp		"00001 00    ..... ..... {2:0} ..... 10100 11"		frd,fs1,fs2,-	"srm; wfd(f1 - f2);       sfx"
   fmul.s.rm	D,S,T,m		F,fp		"00010 00    ..... ..... {2:0} ..... 10100 11"		frd,fs1,fs2,-	"srm; wfd(f1 * f2);       sfx"
   fdiv.s.rm	D,S,T,m		F,fp		"00011 00    ..... ..... {2:0} ..... 10100 11"		frd,fs1,fs2,-	"srm; wfd(f1 / f2);       sfx"
   fsqrt.s.rm	D,S,m		F,fp		"01011 00    00000 ..... {2:0} ..... 10100 11"		frd,fs1,-,-	"srm; wfd(std::sqrt(f1)); sfx"

   fsgnj.s	D,S,T		F,fp		"00100 00    ..... ..... 000   ..... 10100 11"		frd,fs1,fs2,-	"     wrd(fsgnj_s(u1, u2, false, false))"
   fsgnjn.s	D,S,T		F,fp		"00100 00    ..... ..... 001   ..... 10100 11"		frd,fs1,fs2,-	"     wrd(fsgnj_s(u1, u2, true,  false))"
   fsgnjx.s	D,S,T		F,fp		"00100 00    ..... ..... 010   ..... 10100 11"		frd,fs1,fs2,-	"     wrd(fsgnj_s(u1, u2, false,  true))"
